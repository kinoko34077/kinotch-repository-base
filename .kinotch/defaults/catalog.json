      "default_state": "DEFAULT",
      "compatible_surfaces": [
        "minimal",
        "web",
        "cli",
        "gui_windows",
        "mcp",
        "api",
        "agent",
        "library"
      ],
      "aliases": [],
      "reference_entries": {
        "default": "project/tools/logging-default.ps1"
      }
    }
  ]
