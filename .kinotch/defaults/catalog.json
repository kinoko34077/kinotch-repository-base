      "default_state": "DEFAULT",
      "compatible_surfaces": [
        "mcp"
      ],
      "profile": "mcp",
      "aliases": [],
      "reference_entries": {
        "default": "project/tools/mcp-default.ps1",
        "contract": "project/contracts/mcp-tools.json"
      }
    },
    {
      "id": "api",
      "kind": "surface",
      "description": "HTTP API Surface Default。",
      "default_state": "DEFAULT",
