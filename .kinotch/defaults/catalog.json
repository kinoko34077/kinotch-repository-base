        "cli",
        "api",
        "library"
      ],
      "aliases": [],
      "reference_entries": {
        "check": "project/tools/check-generated.ps1",
        "update": "project/tools/update-generated-integrity.ps1"
      }
    },
    {
      "id": "file-io",
