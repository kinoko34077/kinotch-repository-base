      "profile": "api",
      "aliases": [],
      "reference_entries": {
        "default": "project/tools/api-default.ps1",
        "contract": "project/contracts/api-error-envelope.json"
      }
    },
    {
      "id": "agent",
      "kind": "surface",
      "description": "Agent orchestration Surface Default。",
      "default_state": "DEFAULT",
      "compatible_surfaces": [
        "agent"
      ],
      "profile": "agent",
      "aliases": [],
      "reference_entries": {
        "default": "project/tools/agent-default.ps1"
      }
    },
    {
      "id": "library",
      "kind": "surface",
      "description": "Reusable library/package Surface Default。",
      "default_state": "DEFAULT",
      "compatible_surfaces": [
        "library"
      ],
      "profile": "library",
      "aliases": []
