{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinotch.local/defaults/catalog.json",
  "schema_version": 1,
  "defaults": [
    {
      "id": "minimal",
      "kind": "surface",
      "description": "最小構成のSurface Default。",
      "default_state": "DEFAULT",
      "compatible_surfaces": [],
      "profile": "minimal",
      "aliases": []
    },
    {
      "id": "web-app",
      "kind": "surface",
      "description": "Web application Surface Default。",
      "default_state": "DEFAULT",
      "compatible_surfaces": [
        "web"
      ],
      "profile": "web-app",
      "aliases": []
    },
    {
      "id": "cli",
      "kind": "surface",
      "description": "Command-line Surface Default。",
      "default_state": "DEFAULT",
      "compatible_surfaces": [
        "cli"
      ],
      "profile": "cli",
      "aliases": [],
      "reference_entries": {
        "default": "project/tools/cli-default.ps1"
      }
    },
    {
      "id": "windows",
      "kind": "surface",
      "description": "Windows desktop Surface Default。",
      "default_state": "DEFAULT",
      "compatible_surfaces": [
        "gui_windows"
      ],
      "profile": "windows-gui",
      "aliases": [
        "windows-gui"
      ],
      "reference_entries": {
        "default": "project/tools/windows-shell.ps1"
      }
    },
    {
      "id": "mcp",
