{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinotch.local/schema/project.schema.json",
  "title": "KiNoTch Project Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "profile",
    "runtime",
    "surfaces",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "profile": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "required": [
        "modules"
      ],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "run"
            ],
            "properties": {
              "run": {
                "type": "string"
              },
              "cwd": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
