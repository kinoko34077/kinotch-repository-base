{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KiNoTch Action Error",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "enum": [
        "INVALID_INPUT",
        "NOT_FOUND",
        "ALREADY_EXISTS",
        "PERMISSION_DENIED",
        "AUTH_REQUIRED",
        "CONFIG_ERROR",
        "EXTERNAL_ERROR",
        "CANCELLED",
        "INTERNAL_ERROR"
      ]
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "object"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
